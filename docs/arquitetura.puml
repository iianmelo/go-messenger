@startuml arquitetura
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 140
skinparam ranksep 22
skinparam nodesep 18
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam rectangleBackgroundColor #FFFFFF
skinparam rectangleBorderColor #000000
skinparam databaseBackgroundColor #FFFFFF
skinparam databaseBorderColor #000000
skinparam arrowColor #000000

title Componentes em execução

rectangle "Next.js\ngo-messager-ui" as ui
rectangle "Fiber :3000\nCORS liberado" as app

rectangle "POST /auth\nPOST /auth/sign-up\nPOST /resetpassword" as auth
rectangle "GET /chats/user\nWebSocket /chats" as chats
rectangle "GET /users\nPATCH /users\nGET /users/all" as users

rectangle "AUTH_MODE=local\nJWT HS256\n(padrão)" as jwt
rectangle "AUTH_MODE=firebase\nIdentity Toolkit" as fb
database "PostgreSQL\nusers, chats, groups" as pg

ui -down-> app : HTTP e WebSocket
app -down-> auth
app -down-> chats
app -down-> users
auth -down-> jwt
auth -down-> fb
chats -down-> pg
users -down-> pg
jwt -down-> pg
fb -down-> pg

jwt -[hidden]right- fb
fb -[hidden]right- pg
auth -[hidden]right- chats
chats -[hidden]right- users
@enduml
