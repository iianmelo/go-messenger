@startuml sequencia-login
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam dpi 130
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam sequenceArrowThickness 1
skinparam ParticipantPadding 8
skinparam sequenceBoxBackgroundColor #FFFFFF
skinparam sequenceBoxBorderColor #000000
skinparam participantBackgroundColor #FFFFFF
skinparam participantBorderColor #000000
skinparam arrowColor #000000
hide footbox

title AUTH_MODE=local — login, lista e mensagem

participant "Front" as C
participant "Fiber :3000" as F
participant "PostgreSQL" as P

C -> F : POST /auth\n{email, password}
alt corpo inválido ou campos vazios
  F --> C : 400
else e-mail desconhecido ou senha errada
  F -> P : SELECT users
  F --> C : 401 Invalid email or password
else senha confere
  F -> P : SELECT users
  F --> C : 200 {token, user}
end

C -> F : GET /chats/user\nAuthorization: Bearer
alt token ausente ou inválido
  F --> C : 401
else
  F -> P : chats do usuário
  F --> C : 200 [chats]
end

C -> F : WS /chats?token=
C -> F : {text, receiverId}
F -> P : acrescenta a mensagem no JSON
F --> C : eco só se o destinatário estiver conectado
@enduml
