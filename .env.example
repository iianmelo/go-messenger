# Copie este arquivo para .env na raiz do repositório.
# .env e serviceAccountKey.json estão no .gitignore.

DB_HOST=127.0.0.1
DB_USER=messenger
DB_PASSWORD=senha
DB_NAME=messenger
DB_PORT=5432

# Chave Web do projeto Firebase, usada em POST /auth.
FIREBASE_API_KEY=

# Caminho do JSON da conta de serviço (Firebase Admin).
SERVICE_ACCOUNT_JSON=./serviceAccountKey.json
