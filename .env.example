# Copie este arquivo para .env na raiz do repositório.
# .env e serviceAccountKey.json estão no .gitignore.

# local (padrão) emite JWT e não precisa de Firebase.
# firebase usa Identity Toolkit e a conta de serviço.
AUTH_MODE=local
JWT_SECRET=dev-secret-change-me

# true insere os usuários de demonstração quando a tabela users está vazia.
SEED=true

DB_HOST=127.0.0.1
DB_USER=messenger
DB_PASSWORD=senha
DB_NAME=messenger
DB_PORT=5432

# Só com AUTH_MODE=firebase.
FIREBASE_API_KEY=
SERVICE_ACCOUNT_JSON=./serviceAccountKey.json

# Só com AUTH_MODE=firebase, no fluxo de esqueci a senha.
SENDGRID_API_KEY=
